{
    "name": "@nexdk/driver-nhost",
    "version": "0.0.1",
    "description": "GraphQL driver for nexdk — queries and subscriptions over a Hasura/nhost endpoint (graphql-transport-ws).",
    "type": "module",
    "license": "MIT",
    "author": "techmefr",
    "homepage": "https://github.com/techmefr/nexdk/tree/main/packages/drivers/nhost#readme",
    "bugs": {
        "url": "https://github.com/techmefr/nexdk/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/techmefr/nexdk.git",
        "directory": "packages/drivers/nhost"
    },
    "keywords": [
        "nexdk",
        "driver",
        "sdk",
        "nhost",
        "hasura",
        "graphql",
        "subscriptions"
    ],
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "unbuild",
        "test": "vitest run",
        "dev": "unbuild --stub"
    },
    "peerDependencies": {
        "nexdk": ">=0.0.1 <1"
    },
    "devDependencies": {
        "nexdk": "workspace:*",
        "typescript": "^5.9.3",
        "unbuild": "^3.6.1",
        "vitest": "^5.0.5",
        "zod": "^3.24.0"
    }
}
