{
    "name": "@nexdk/driver-pocketbase",
    "version": "0.0.1",
    "description": "PocketBase REST driver for nexdk - records API with filter, sort and pagination.",
    "type": "module",
    "license": "MIT",
    "author": "techmefr",
    "homepage": "https://github.com/techmefr/nexdk/tree/main/packages/drivers/pocketbase#readme",
    "bugs": {
        "url": "https://github.com/techmefr/nexdk/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/techmefr/nexdk.git",
        "directory": "packages/drivers/pocketbase"
    },
    "keywords": [
        "nexdk",
        "driver",
        "sdk",
        "pocketbase",
