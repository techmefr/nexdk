        "@nexdk/http": ">=0.0.1 <1"
    },
    "devDependencies": {
        "@nexdk/http": "workspace:*",
        "nexdk": "workspace:*",
        "typescript": "^5.9.3",
        "unbuild": "^3.6.1",
        "vitest": "^5.0.5",
