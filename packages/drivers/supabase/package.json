{
    "name": "@nexdk/driver-supabase",
    "version": "0.0.1",
    "description": "Realtime driver for nexdk — subscribes to Supabase postgres_changes over @supabase/supabase-js.",
    "type": "module",
    "license": "MIT",
    "author": "techmefr",
    "homepage": "https://github.com/techmefr/nexdk/tree/main/packages/drivers/supabase#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/techmefr/nexdk.git",
        "directory": "packages/drivers/supabase"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "unbuild",
        "test": "vitest run",
        "dev": "unbuild --stub"
    },
    "peerDependencies": {
        "nexdk": "workspace:*"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.43.0"
    },
    "devDependencies": {
        "nexdk": "workspace:*",
        "typescript": "^5.9.3",
        "unbuild": "^3.6.1",
        "vitest": "^5.0.5"
    }
}
