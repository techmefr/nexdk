{
    "name": "@nexdk/hooks",
    "version": "0.0.1",
    "description": "Vue composables for nexdk resources — useResourceForm builds form state, dirty-tracking and server-error mapping from a resource's Zod schema.",
    "type": "module",
    "license": "MIT",
    "author": "techmefr",
    "homepage": "https://github.com/techmefr/nexdk/tree/main/packages/hooks#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/techmefr/nexdk.git",
        "directory": "packages/hooks"
    },
    "keywords": [
        "vue",
        "forms",
        "zod",
        "composable",
        "nexdk"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "unbuild",
        "test": "vitest run",
        "dev": "unbuild --stub"
    },
    "peerDependencies": {
        "nexdk": "workspace:*",
        "vue": "^3.4.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "nexdk": "workspace:*",
        "typescript": "^5.9.3",
        "unbuild": "^3.6.1",
        "vitest": "^5.0.5",
        "vue": "^3.5.0",
        "zod": "^3.24.0"
    }
}
